<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/coordinatorLayout"
    android:layout_height="match_parent"
    tools:context=".activity.OpenSavingsAccountActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/custom_toolbar_include"
            layout="@layout/custom_toolbar" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    card_view:cardCornerRadius="6dp"
                    card_view:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="5dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/SelectProduct"
                                android:textSize="@dimen/text_16sp"
                                android:textColor="@color/black"
                                android:typeface="serif" />
                            <Spinner
                                android:id="@+id/product_spi"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/spinner_border"
                                android:padding="10dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/CreditAmount"
                                android:layout_marginTop="10dp"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_15sp">
                            </TextView>
                            <EditText
                                android:id="@+id/et_credit_amt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="false"
                                android:typeface="serif" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txt_amountinwords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/AmountinWords"
                            android:layout_marginTop="10dp"
                            android:textSize="@dimen/text_15sp"
                            android:textColor="@color/greenColor">
                        </TextView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="5dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/InstallmentFrequency"
                                android:textSize="@dimen/text_16sp"
                                android:textColor="@color/black"
                                android:typeface="serif" />
                            <Spinner
                                android:id="@+id/spi_install_freq"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/spinner_border"
                                android:padding="10dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ApplicationDate"
                                android:layout_marginTop="10dp"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_15sp">
                            </TextView>
                            <TextView
                                android:id="@+id/txt_application_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableRight="@drawable/dateicon"
                                android:hint="@string/dd_MMM_yyyy"
                                android:background="@drawable/edit_text_border"
                                android:layout_margin="3dp"
                                android:paddingLeft="3dp"
                                android:layout_weight="1">
                            </TextView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/TenorperiodInMonths"
                                android:layout_marginTop="10dp"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_15sp">
                            </TextView>
                            <EditText
                                android:id="@+id/et_tenor_period"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="false"
                                android:typeface="serif" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/txt_expiry_date"
                                android:layout_marginTop="10dp"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_15sp">
                            </TextView>
                            <TextView
                                android:id="@+id/txt_expiry_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableRight="@drawable/dateicon"
                                android:hint="@string/dd_MMM_yyyy"
                                android:background="@drawable/edit_text_border"
                                android:layout_margin="3dp"
                                android:paddingLeft="3dp"
                                android:layout_weight="1">
                            </TextView>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_submit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/submit"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/press_buttons"
                            android:textColor="@color/colorWhite"
                            android:textSize="@dimen/text_15sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>