<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/coordinatorLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.InvestmentClosureActivity"
    android:layout_margin="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include
            android:id="@+id/custom_toolbar_include"
            layout="@layout/custom_toolbar" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:layout_marginHorizontal="5dp"
                    card_view:cardCornerRadius="6dp"
                    card_view:cardElevation="6dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="15dp"
                        android:paddingHorizontal="4dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/SelectInvestmentAccount"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14sp"
                            android:typeface="serif"  />
                        <Spinner
                            android:id="@+id/spinnerFrmActId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/spinner_border"
                            android:padding="10dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_invest_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="20dp"
                    android:layout_marginHorizontal="5dp"
                    card_view:cardCornerRadius="6dp"
                    card_view:cardElevation="6dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginHorizontal="4dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:paddingVertical="5dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6"
                                android:text="@string/ProductName"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:gravity="center"
                                android:text="@string/txt_colon"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <TextView
                                android:id="@+id/product_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:textColor="@color/light_black"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:paddingVertical="5dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6"
                                android:text="@string/CertificationNumber"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:gravity="center"
                                android:text="@string/txt_colon"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <TextView
                                android:id="@+id/cert_no"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:textColor="@color/light_black"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:paddingVertical="5dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6"
                                android:text="@string/txt_maturity_amount"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:gravity="center"
                                android:text="@string/txt_colon"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_weight="0.5">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/light_black"
                                    android:text="$ "
                                    android:textSize="@dimen/text_14sp"
                                    android:typeface="serif"/>
                                <TextView
                                    android:id="@+id/maturity_amt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/light_black"
                                    android:textSize="@dimen/text_14sp"
                                    android:typeface="serif" />
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/red_circle"
                                    android:layout_gravity="center_vertical"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:paddingVertical="5dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6"
                                android:text="@string/InvestmentAccountNumber"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:gravity="center"
                                android:text="@string/txt_colon"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <TextView
                                android:id="@+id/invest_acc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:textColor="@color/light_black"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:paddingVertical="5dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6"
                                android:text="@string/hint_remarks"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:gravity="center"
                                android:text="@string/txt_colon"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                            <EditText
                                android:id="@+id/et_remarks"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:textColor="@color/light_black"
                                android:textSize="@dimen/text_14sp"
                                android:typeface="serif" />
                        </LinearLayout>
                        <Button
                            android:id="@+id/btn_proceed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_proceed"
                            android:layout_marginVertical="50dp"
                            android:textColor="@color/colorWhite"
                            android:textSize="@dimen/text_22sp"
                            android:background="@drawable/press_buttons">
                        </Button>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>