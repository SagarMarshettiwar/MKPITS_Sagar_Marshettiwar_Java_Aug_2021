<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.StandingInstructionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            app:cardCornerRadius="3dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Debit Account Number"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/black"
                    android:typeface="serif" />

                <Spinner
                    android:id="@+id/spinnerFrmActId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/spinner_border"
                    android:padding="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Credit Account Number"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/black"
                    android:typeface="serif"
                    android:layout_marginTop="10dp" />

                <Spinner
                    android:id="@+id/spinnerToActId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/spinner_border"
                    android:padding="10dp" />

                <LinearLayout
                    android:id="@+id/lv_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="Execution Date"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_14sp"
                        android:typeface="serif" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:gravity="center"
                        android:text="@string/txt_colon"
                        android:textSize="@dimen/text_14sp"
                        android:typeface="serif" />


                    <TextView
                        android:id="@+id/exec_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:textColor="@color/black"
                        android:text="LoanAmount"
                        android:textSize="@dimen/text_14sp"
                        android:typeface="serif" />
                </LinearLayout>
                <ListView
                    android:id="@+id/lv_exist_list"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:scrollbars="vertical" />

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/ll_exectuiondetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Execution Details"
                            android:gravity="center"
                            android:background="?attr/colorPrimary"
                            android:layout_marginTop="10dp"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_20sp"
                            android:textColor="@color/black" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="First Execution Date"
                            android:textSize="@dimen/text_16sp"
                            android:textColor="@color/black"
                            android:typeface="serif" />

                        <TextView
                            android:id="@+id/tv_ExecutionDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/edit_text_border"
                            android:drawableRight="@drawable/ic_arrow_drop_down_black_24dp"
                            android:padding="10dp"
                            android:hint="Set Execution Date"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_14sp"
                            android:typeface="serif" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Execution Frequency"
                            android:textSize="@dimen/text_16sp"
                            android:textColor="@color/black"
                            android:typeface="serif"
                            android:layout_marginTop="10dp" />

                        <Spinner
                            android:id="@+id/spinnerFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/spinner_border"
                            android:padding="10dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Execution Period (In Months)"
                            android:layout_marginTop="10dp"
                            android:textSize="@dimen/text_16sp"
                            android:textColor="@color/black" />

                        <EditText
                            android:id="@+id/et_ExecutionPeriod"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:inputType="number"
                            android:textColor="@color/black" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Transfer Amount"
                            android:layout_marginTop="10dp"
                            android:textSize="@dimen/text_16sp"
                            android:textColor="@color/black" />

                        <EditText
                            android:id="@+id/et_Amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:inputType="numberDecimal"
                            android:textColor="@color/black" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Remark"
                            android:layout_marginTop="10dp"
                            android:textSize="@dimen/text_16sp"
                            android:textColor="@color/black" />

                        <EditText
                            android:id="@+id/et_remark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black" />

                        <Button
                            android:id="@+id/btn_Submit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="Submit"
                            android:background="?attr/colorPrimary"
                            android:textColor="@color/colorWhite"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
