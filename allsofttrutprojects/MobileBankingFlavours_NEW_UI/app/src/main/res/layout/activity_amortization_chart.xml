<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:orientation="vertical"
    android:padding="5dp"
    android:filterTouchesWhenObscured="true">


    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        card_view:cardCornerRadius="2dp"
        card_view:cardElevation="3dp"
        card_view:cardUseCompatPadding="true">


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/LLparentId"
                android:orientation="vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <!--android:theme="@style/TextLabel">-->
                        <EditText
                            android:id="@+id/editTextDisbursementDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Disbursement Date"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:typeface="serif" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="10dp"
                            android:text="Select Method "
                            android:textSize="@dimen/text_16sp"
                            android:typeface="serif"/>

                        <Spinner
                            android:id="@+id/spinnerMethod_Id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/spinner_border"
                            android:padding="10dp"  />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <!--android:theme="@style/TextLabel">-->
                        <EditText
                            android:id="@+id/editTextLoanAmount_Id1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Loan Amount"
                            android:inputType="number"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:typeface="serif" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <LinearLayout
                        android:id="@+id/layoutLoanPeriodUnit"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="10dp"
                            android:text="Loan Period Unit "
                            android:textSize="@dimen/text_16sp"
                            android:typeface="serif"/>

                        <Spinner
                            android:id="@+id/spLoanPeriodUnit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/spinner_border"
                            android:padding="10dp"  />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <!--android:theme="@style/TextLabel">-->
                        <EditText
                            android:id="@+id/editTextLoanPeriod_Id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Loan Period "
                            android:inputType="number"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:typeface="serif" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <!--android:theme="@style/TextLabel">-->
                        <EditText
                            android:id="@+id/editTextExpiryDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Expiry Date"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:typeface="serif" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <LinearLayout
                        android:id="@+id/layoutInterestAppliedFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textViewInstallmentAppliedFrequency_Id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="10dp"
                            android:text="Select Installment Applied Frequency"
                            android:textSize="@dimen/text_16sp"
                            android:typeface="serif"/>

                        <Spinner
                            android:id="@+id/spinnerInstallmentAppliedFrequency_Id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/spinner_border"
                            android:padding="10dp"  />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutInterestCompoundFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="10dp"
                            android:text="Select Intrest Compounding Frequency"
                            android:textSize="@dimen/text_16sp"
                            android:typeface="serif"/>

                        <Spinner
                            android:id="@+id/spinnerIntrestCompoundingFrequency_Id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/spinner_border"
                            android:padding="10dp"  />
                    </LinearLayout>

                    <!--For DIB drop down list-->
                    <!--android:visibility="gone"-->
                    <LinearLayout
                        android:id="@+id/layoutInterestRepaymentFrequency"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="10dp"
                            android:text="Interest Repayment Frequency"
                            android:textSize="@dimen/text_16sp"
                            android:typeface="serif"/>

                        <Spinner
                            android:id="@+id/spInterestRepaymentFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/spinner_border"
                            android:padding="10dp"  />
                    </LinearLayout>

                    <!-- android:visibility="gone"-->
                    <LinearLayout
                        android:id="@+id/layoutPrincipleRepaymentFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="10dp"
                            android:text="Principal Repayment Frequency"
                            android:textSize="@dimen/text_16sp"
                            android:typeface="serif"/>

                        <Spinner
                            android:id="@+id/spPrincipalRepaymentFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/spinner_border"
                            android:padding="10dp"  />
                    </LinearLayout>
                    <!--For DIB drop down list-->
                    <!--For DIB Number of installment edittext-->
                    <!--android:visibility="gone"-->
                    <LinearLayout
                        android:id="@+id/layoutNumberOfInstallment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <!--android:theme="@style/TextLabel">-->

                            <EditText
                                android:id="@+id/edNumberOfInstallment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Number of Installment"
                                android:inputType="textPersonName"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:typeface="serif" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <!--For DIB Number of installment-->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <!--android:theme="@style/TextLabel">-->

                        <EditText
                            android:id="@+id/editTextFirstInstallmentDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:hint="Select First Installment Date"
                            android:inputType="none"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:typeface="serif" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!--android:visibility="gone"-->
                    <LinearLayout
                        android:id="@+id/layoutFirstInterestInstallmentDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <!--android:theme="@style/TextLabel">-->

                            <EditText
                                android:id="@+id/edFirstInterestInstallmentDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select First Interest Installment Date"
                                android:inputType="textPersonName"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:typeface="serif" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <!--android:theme="@style/TextLabel">-->

                        <EditText
                            android:id="@+id/editTextInterestRate_Id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Interest Rate "
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:typeface="serif" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:padding="10dp">

                        <Button
                            android:id="@+id/buttonCancelAm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:layout_weight="1"
                            android:text="Cancel" />

                        <Button
                            android:id="@+id/buttonShow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:layout_weight="1"
                            android:layout_marginLeft="30dp"
                            android:text="Finish "/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
                <include layout="@layout/custom_horizontal_recycler_view" />
            </RelativeLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
