<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayoutId"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:filterTouchesWhenObscured="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:layout_margin="5dp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_bill_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    card_view:cardCornerRadius="3dp"
                    card_view:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <ImageView
                            android:id="@+id/ivAppLogo"
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:contentDescription="@string/txt_mob_banking"
                            android:gravity="center"
                            android:src="@drawable/ic_launcher" />

                        <TextView
                            android:id="@+id/bank_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/app_name"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="e-Receipt"
                            android:layout_marginVertical="5dp"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_16sp"
                            android:typeface="serif" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="@color/black"
                            ></LinearLayout>
                        <TextView
                            android:id="@+id/Title_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/app_name"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_16sp"
                            android:textStyle="bold" />
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:id="@+id/transaction_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.9"
                                        android:text="Txn Date"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_14sp"
                                        android:typeface="serif" />
                                    <TextView
                                        android:id="@+id/txt_date"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="?attr/textColour"
                                        android:textSize="@dimen/text_14sp"
                                        android:textStyle="bold"
                                        android:typeface="serif"
                                        android:textAlignment="textEnd"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/transaction_ref_id"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.9"
                                        android:text="Txn Ref Id"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_14sp"
                                        android:typeface="serif" />
                                    <TextView
                                        android:id="@+id/txt_ref_id"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="?attr/textColour"
                                        android:textSize="@dimen/text_14sp"
                                        android:textStyle="bold"
                                        android:typeface="serif"
                                        android:textAlignment="textEnd"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/ll_customer_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.9"
                                        android:text="Customer Name"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_14sp"
                                        android:typeface="serif" />
                                    <TextView
                                        android:id="@+id/txt_customer_name"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="?attr/textColour"
                                        android:textSize="@dimen/text_14sp"
                                        android:textStyle="bold"
                                        android:typeface="serif"
                                        android:textAlignment="textEnd"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/biller_category"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.9"
                                        android:text="From Account Number"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_14sp"
                                        android:typeface="serif" />
                                    <TextView
                                        android:id="@+id/txt_toaccnoo"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.5"
                                        android:textColor="?attr/textColour"
                                        android:textSize="@dimen/text_14sp"
                                        android:textStyle="bold"
                                        android:typeface="serif"
                                        android:textAlignment="textEnd"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/biller_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.9"
                                        android:text="Amount"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_14sp"
                                        android:typeface="serif" />
                                    <TextView
                                        android:id="@+id/txt_Amount"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="?attr/textColour"
                                        android:textSize="@dimen/text_14sp"
                                        android:textStyle="bold"
                                        android:typeface="serif"
                                        android:textAlignment="textEnd"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/ll_benname"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.9"
                                        android:text="Beneficiary Name"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_14sp"
                                        android:typeface="serif" />

                                    <TextView
                                        android:id="@+id/txt_benname"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="?attr/textColour"
                                        android:textSize="@dimen/text_14sp"
                                        android:textStyle="bold"
                                        android:typeface="serif"
                                        android:textAlignment="textEnd"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/bill_number"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:id="@+id/tv_toaccno"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.9"
                                        android:text="To Account Number"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_14sp"
                                        android:typeface="serif" />
                                    <TextView
                                        android:id="@+id/txt_toaccnumber"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="?attr/textColour"
                                        android:textSize="@dimen/text_14sp"
                                        android:textStyle="bold"
                                        android:typeface="serif"
                                        android:textAlignment="textEnd"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/ll_utrno"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.9"
                                        android:text="UTR No"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_14sp"
                                        android:typeface="serif" />
                                    <TextView
                                        android:id="@+id/txt_Utrno"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="?attr/textColour"
                                        android:textSize="@dimen/text_14sp"
                                        android:textStyle="bold"
                                        android:typeface="serif"
                                        android:textAlignment="textEnd"/>
                                </LinearLayout>

                            </LinearLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="10dp"
                            android:background="@color/black"
                            ></LinearLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btn_save"
                    style="?android:textAppearanceSmall"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginTop="20dp"
                    android:text="Save"
                    android:background="?attr/textColorPrimary"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/text_14sp"
                    android:layout_gravity="center_horizontal"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:typeface="serif" />

                <Button
                    android:id="@+id/btn_share"
                    style="?android:textAppearanceSmall"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginTop="20dp"
                    android:text="Share"
                    android:background="?attr/textColorPrimary"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/text_14sp"
                    android:layout_gravity="center_horizontal"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:typeface="serif" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>